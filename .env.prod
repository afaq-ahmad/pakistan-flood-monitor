DATABASE_DSN=postgresql+psycopg://prod:prod@prod-db:5432/flood_monitor
STORAGE_RAW_ROOT=/data/raw
STORAGE_PREPARED_ROOT=/data/prepared
STORAGE_DERIVED_ROOT=/data/derived
STORAGE_PUBLISHED_ROOT=/data/published
API_BASE_URL=https://flood-monitor.example.com
DEFAULT_CRS=EPSG:4326
CORRIDOR_BUFFER_METERS=2000
FLOOD_THRESHOLDS_PATH=config/thresholds/flood_thresholds.yaml
BREACH_WEIGHTS_PATH=config/thresholds/breach_weights.yaml
STAC_ENDPOINT=https://stac.example.com
HYDROMET_ENDPOINT=https://hydromet.example.com
LOG_LEVEL=WARNING
ENABLE_PREFECT_WORKERS=true
