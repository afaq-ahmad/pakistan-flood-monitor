DATABASE_DSN=postgresql+psycopg://staging:staging@staging-db:5432/flood_monitor
STORAGE_RAW_ROOT=storage/raw
STORAGE_PREPARED_ROOT=storage/prepared
STORAGE_DERIVED_ROOT=storage/derived
STORAGE_PUBLISHED_ROOT=storage/published
API_BASE_URL=https://staging-flood-monitor.example.com
DEFAULT_CRS=EPSG:4326
CORRIDOR_BUFFER_METERS=1500
FLOOD_THRESHOLDS_PATH=config/thresholds/flood_thresholds.yaml
BREACH_WEIGHTS_PATH=config/thresholds/breach_weights.yaml
STAC_ENDPOINT=https://staging-stac.example.com
HYDROMET_ENDPOINT=https://staging-hydromet.example.com
LOG_LEVEL=INFO
ENABLE_PREFECT_WORKERS=true
