# Never commit a populated .env file. APP_MODE is an explicit safety boundary.
APP_MODE=demo
DATABASE_URL=sqlite:///./storage/pakistan_flood_monitor.db
WORKFLOW_MAX_ATTEMPTS=3

# Replace before exposing any internal endpoint. Keep real values only in your
# untracked local/deployment secret store.
FLOOD_MONITOR_ADMIN_TOKEN=replace-with-a-long-random-token
FLOOD_MONITOR_ANALYST_TOKEN=replace-with-a-long-random-token

# docker-compose.yml reads these only when using the PostGIS service.
POSTGRES_USER=flood_monitor_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=flood_monitor_db
